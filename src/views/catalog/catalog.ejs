<!-- Source from ejs templates -->
<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<!-- MAIN CONTENT HERE -->
<main>
  <h1>Course Catalog</h1>
  <p>Browse our available courses and click on any course to see detailed information including available sections and
    instructors.</p>
  <p><a href="/catalog/random">View a Random Course</a> to explore something new.</p>
  <div class="course-list">
    <% Object.values(courses).forEach(course => { %>
    <div class="course-card">
      <h3><a href="/catalog/<%= course.id %>"><%= course.title %></a></h3>
      <p class="course-id"><%= course.id %> • <%= course.credits %> credits</p>
      <p class="course-description"><%= course.description %></p>
    </div>
    <% }); %>
  </div>
</main>

<%- include('../partials/footer') %>