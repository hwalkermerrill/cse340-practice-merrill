<!-- Source from ejs templates -->
<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/nav") %>

<!-- MAIN CONTENT HERE -->
<main>
  <div class="course-header">
    <h1><%= course.name %></h1>
    <p class="course-meta"><%= course.courseCode %> • <%= course.creditHours %> credits</p>
    <p class="course-description"><%= course.description %></p>
  </div>
  <div class="sections">
    <div class="sections-header">
      <h2>Available Sections</h2>
      <div class="sort-options">
        <span>Sort by: </span>
        <a href="/catalog/<%= course.slug %>" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a>
        <a href="/catalog/<%= course.slug %>?sort=professor"
          class="<%= currentSort === 'professor' ? 'active' : '' %>">Professor</a>
        <a href="/catalog/<%= course.slug %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
      </div>
    </div>
    <!-- Fail Gracefully -->
    <% if (sections.length === 0) { %>
    <p>No sections available.</p>
    <% } else { %>
    <div class="section-list">
      <% sections.forEach(section => { %>
      <div class="section-card">
        <div class="section-time"><%= section.time %></div>
        <div class="section-room">Room: <%= section.room %></div>
        <div class="section-professor">
          Instructor:
          <a href="/faculty/<%= section.professorSlug %>">
            <%= section.professor %>
          </a>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
  <div class="navigation">
    <p><a href="/catalog">&larr; Back to Course Catalog</a></p>
    <p><a href="/catalog/random">View a Random Course</a> to explore something new.</p>
  </div>
</main>

<%- include('../partials/footer') %>